POLYAPI_NAMESPACE=example
TARGET_ENV_ID=replace-with-environment-id
# Optional overrides; otherwise use `pnpm workflows exec poly setup`.
# BASE_URL=https://eu1.polyapi.io
# API_KEY=replace-with-your-dev-api-key
SLACK_CHANNEL_ID=replace-with-your-slack-channel-id
LOG_LEVEL=debug

# Optional Flow CLI settings
POLYAPI_DESIGNS_DIR=designs
GIT_PROD_BRANCH=main:prod.env
GIT_PROD_SKIP_BRANCHES=develop:dev.env
