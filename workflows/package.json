{
  "name": "workflows",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript PolyAPI workflow implementations",
  "main": "index.js",
  "scripts": {
    "push": "pnpm --filter flow-cli run build && node ../cli/dist/cli.js push",
    "push:dry-run": "pnpm --filter flow-cli run build && node ../cli/dist/cli.js push --dry-run",
    "test": "ava",
    "test:integration": "ava --config ava.config.integration.cjs",
    "test:integration:mutating": "RUN_MUTATING_INTEGRATION=true ava --config ava.config.integration.cjs",
    "test:all": "ava && ava --config ava.config.integration.cjs",
    "train:openapi": "pnpm --filter flow-cli run train:openapi",
    "delete:content": "pnpm --filter flow-cli run delete:content",
    "logs": "pnpm --filter flow-cli run logs"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "src/**/*.test.ts",
      "!src/**/*.integration.test.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "timeout": "60s"
  },
  "dependencies": {
    "polyapi": "^0.27.4"
  },
  "devDependencies": {
    "@ava/typescript": "^6.0.0",
    "@types/node": "^25.0.10",
    "ava": "^6.4.1",
    "dotenv": "^17.2.3",
    "flow-cli": "workspace:*",
    "swagger2openapi": "^7.0.8",
    "ts-node": "^10.9.2",
    "typescript": ">=5.8.3 <5.9.0"
  }
}
