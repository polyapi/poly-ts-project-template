{
  "name": "flow-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Flow CLI for syncing local PolyAPI TypeScript artefacts",
  "main": "dist/cli.js",
  "bin": {
    "flow": "bin/flow.js"
  },
  "scripts": {
    "build": "tsc",
    "generate": "pnpm exec tsx src/codegen/generate.ts"
  },
  "keywords": [
    "polyapi",
    "flow",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "ajv": "^8.17.1",
    "chalk": "4.1.2",
    "dotenv": "^17.2.3",
    "openapi-fetch": "^0.15.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "polyapi": "^0.25.9"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsx": "^4.7.0",
    "typescript": ">=5.8.3 <5.9.0",
    "yaml": "^2.8.2"
  }
}
