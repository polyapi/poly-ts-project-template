{
  "name": "poly-ts-project-template",
  "version": "1.0.0",
  "private": true,
  "description": "Generic TypeScript PolyAPI project template",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "workflows": "pnpm --filter workflows",
    "flow": "pnpm --filter flow-cli",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "keywords": [
    "polyapi",
    "typescript",
    "template"
  ],
  "author": "PolyAPI",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.13"
  }
}
