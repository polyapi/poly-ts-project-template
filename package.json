{
  "name": "poly-ts-project-template",
  "version": "1.0.0",
  "private": true,
  "description": "Generic TypeScript PolyAPI project template",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "test": "pnpm --filter workflows test",
    "test:watch": "pnpm --filter workflows test -- --watch",
    "test:integration": "pnpm --filter workflows test:integration",
    "test:integration:mutating": "pnpm --filter workflows test:integration:mutating",
    "workflows": "ENVIRONMENT_SETUP_COMPLETE=true pnpm --filter workflows",
    "dyn:dev": "ENVPATH=workflows/dev.env pnpm workflows push:dynamic",
    "dyn:dev:dry": "ENVPATH=workflows/dev.env pnpm workflows push:dynamic:dry-run",
    "dyn:prod": "ENVPATH=workflows/prod.env pnpm workflows push:dynamic",
    "dyn:prod:dry": "ENVPATH=workflows/prod.env pnpm workflows push:dynamic:dry-run",
    "flow": "pnpm --filter flow-cli",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "keywords": [
    "polyapi",
    "typescript",
    "template"
  ],
  "author": "PolyAPI",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13"
  }
}
